# Google AI Studio Gemini API Key
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional: Legacy Google API Key fallback
GOOGLE_API_KEY=

# Optional: Model selection (Default: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Optional: Worker mode: auto | enabled | disabled (Default: auto)
AI_WORKER_MODE=auto

# Optional: Local Safety Quota Limits
# AI_WORKER_DAILY_BUDGET=1400
# AI_WORKER_RPM_BUDGET=12
