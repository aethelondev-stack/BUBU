# ===========================================================================
# BUBU / LLM Context Worker Environment Configuration
# ===========================================================================

# Active LLM Provider: gemini (default) | openai_compatible
AI_WORKER_PROVIDER=gemini

# ---------------------------------------------------------------------------
# Provider #1: Google Gemini (Default & Free Tier Available)
# ---------------------------------------------------------------------------
# Get your free Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional: Legacy Google API Key fallback
GOOGLE_API_KEY=

# Optional: Gemini model selection (Default: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------------------
# Provider #2: OpenAI-Compatible HTTP API (Optional Alternative)
# Compatible with OpenAI, DeepSeek, OpenRouter, Qwen, Ollama, vLLM, etc.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=YOUR_OPENAI_OR_DEEPSEEK_API_KEY_HERE
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Worker Behavior & Quota Limits
# ---------------------------------------------------------------------------
# Worker mode: auto | enabled | disabled (Default: auto)
AI_WORKER_MODE=auto

# Optional: Local Safety Quota Limits
# AI_WORKER_DAILY_BUDGET=1400
# AI_WORKER_RPM_BUDGET=12
