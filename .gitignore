.ai-worker/reports/*
!.ai-worker/reports/.gitkeep
.ai-worker/quota/*
!.ai-worker/quota/.gitkeep

# Python cache & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.tmp
*.log

# Virtual environments
venv/
.venv/
env/
.env/

# IDE and OS metadata
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

